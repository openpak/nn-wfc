# nn-wfc: Nintendo WFC (Wii and DS) replacement, WiiLink's wfc-server on OpenPak.
WFC_DB_USER=openpak
WFC_DB_PASSWORD=secret
WFC_DB_ADDRESS=openpak-postgres
WFC_DB_NAME=wwfc            # import schema.sql once
WFC_NAS_PORT=20120          # plain HTTP for nas/naswii/dls1/sake/gamestats/race names, behind Traefik :80
WFC_API_SECRET=change-me
WFC_LOG_LEVEL=4
WFC_CORE_ADDRESS=           # the account core's gRPC address; empty = no core, no translator
WFC_CORE_KEY=               # the core's X-API-Key for the Events poll
